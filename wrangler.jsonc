{
  "name": "tg-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-26",
  // Logs only. Do not enable traces: fetch spans would record the Telegram URL, which contains the bot token.
  "observability": { "enabled": true }
  // Secrets (set with `wrangler secret put`): STRIPE_WEBHOOK_SECRET, TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID
}
